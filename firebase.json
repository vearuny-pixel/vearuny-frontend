{
  "hosting": {
    "public": "site",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/{test,tests,backups,backup,docs,evidence,scripts,recovered}/**",
      "**/*.{env,pem,key,p12,pfx,log,bak,sql,zip,tar,gz,map}",
      "**/*service-account*",
      "**/*firebase-adminsdk*",
      "**/{package.json,package-lock.json,AGENTS.md,SKILL.md}"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/privacy",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "index, follow"
          }
        ]
      },
      {
        "source": "/privacy/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "index, follow"
          }
        ]
      }
    ],
    "predeploy": [
      "python3 -B scripts/firebase-deploy-guard.py"
    ],
    "site": "vearuny"
  }
}
